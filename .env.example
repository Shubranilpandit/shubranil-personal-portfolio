# Environment Mode: development | production
FLASK_ENV=development
PORT=5000

# Database Configuration:
# Leave blank for zero-config local SQLite fallback (sqlite:///portfolio.db),
# or provide PostgreSQL connection string for production:
# DATABASE_URL=postgresql://tron_user:TronSecurePass2026@localhost:5432/shubranil_portfolio
DATABASE_URL=

# Docker Compose PostgreSQL Credentials (if running with docker compose):
POSTGRES_USER=tron_user
POSTGRES_PASSWORD=TronSecurePass2026
POSTGRES_DB=shubranil_portfolio

# Secret Keys for Security & JWT
SECRET_KEY=tron-cyber-secret-key-shubranil-2026-mca
JWT_SECRET_KEY=tron-jwt-secret-key-2026
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# GitHub API Integration
GITHUB_USERNAME=shubranil-pandit
GITHUB_TOKEN=

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=*

# Contact Form Security & Anti-Spam
RATELIMIT_CONTACT_PER_HOUR=5

# Frontend API URL (for Vite dev server)
VITE_API_URL=http://localhost:5000
